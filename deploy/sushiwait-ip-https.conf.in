# Prepared only. Enable after owner accepts the CA agreement and cert issuance.
server {
    listen 80;
    server_name 124.222.57.236;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/sushiwait-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://124.222.57.236$request_uri; }
}
server {
    listen 18080;
    server_name 124.222.57.236;
    access_log off;
    return 308 https://124.222.57.236$request_uri;
}
server {
    listen 443 ssl;
    server_name 124.222.57.236;
    ssl_certificate /etc/letsencrypt/live/sushiwait-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sushiwait-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 4k;
    access_log off;
    location = /brand-wordmark.svg {
        alias /var/www/sushiwait-assets/brand-wordmark.svg;
        default_type image/svg+xml;
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options nosniff always;
    }
    location ^~ /recover/ {
        proxy_pass http://127.0.0.1:18910;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 50s;
        add_header Referrer-Policy no-referrer always;
    }
    location = /api/v1/research/screenshots/recognize {
        client_max_body_size 6m;
        proxy_pass http://127.0.0.1:18900;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 35s;
    }
    location = /api/v1/analytics {
        proxy_pass http://127.0.0.1:18900;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 40s;
    }
    location / {
        proxy_pass http://127.0.0.1:18900;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 20s;
    }
}
